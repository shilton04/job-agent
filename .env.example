# --- Job data sources ---
# Free tier: https://developer.adzuna.com/  (covers India + most countries)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Free tier (500 req/month): https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Aggregates LinkedIn, Indeed, Naukri-style listings
JSEARCH_API_KEY=

# --- LLM for scoring + tailoring ---
# Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Email digest (Gmail app password, not your real password) ---
# Create one at https://myaccount.google.com/apppasswords
EMAIL_USER=you@gmail.com
EMAIL_APP_PASSWORD=
EMAIL_TO=you@gmail.com

# --- Search config ---
# Comma-separated keywords pulled from your resume skills
SEARCH_KEYWORDS=Vue.js,React,Node.js,full stack developer
SEARCH_LOCATION=Bengaluru
MATCH_THRESHOLD=70
